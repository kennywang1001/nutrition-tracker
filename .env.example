DATABASE_URL=postgresql+asyncpg://wallet:wallet@localhost:5433/wallet
TEST_DATABASE_URL=postgresql+asyncpg://wallet:wallet@localhost:5433/wallet_test
# JWT_SECRET 沒有預設值可以退回（fail closed）：沒設會讓 Settings() 在啟動當下
# 就丟 ValidationError（pytest、alembic、`uvicorn app.main:app` 都一樣）。
# 本機開發請自行產生一組，例如：
#   openssl rand -hex 32
# 絕對不要用 "dev-secret-change-me-in-production"——那個字面字串在公開的
# GitHub repo 裡，等於沒有密鑰，Settings 會直接拒絕啟動。
JWT_SECRET=
PHOTO_DIR=data/photos
