# 使用者上傳的照片（存在 Docker volume / NAS 資料夾，不進版控）
data/photos/

# scripts/backup.sh 的預設輸出目錄：資料庫備份檔，不進版控
backups/

# scripts/deploy.sh 寫的版本紀錄（這台機器目前跑哪個 commit 的映像），不進版控
deployed-version
# scripts/deploy.sh 的部署鎖（flock 用的檔案；沒有 flock 時是資料夾）
.deploy.lock
.deploy.lock.d/

# 編輯器與作業系統
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 前端
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/

# brainstorming 的視覺輔助頁面（mockup 暫存，不進版控）
.superpowers/
